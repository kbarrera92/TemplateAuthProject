### Unidades de medida

# @name crearUnidadMedida
POST {{TemplateProject_HostAddress}}/api/unidades-medida
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json; charset=utf-8

{
  "nombre": "Libras",
  "abreviatura": "lbs"
}

###

@unidadMedidaId = {{crearUnidadMedida.response.body.$.id}}

GET {{TemplateProject_HostAddress}}/api/unidades-medida
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{TemplateProject_HostAddress}}/api/unidades-medida?activo=true
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{TemplateProject_HostAddress}}/api/unidades-medida/{{unidadMedidaId}}
Authorization: Bearer {{token}}
Accept: application/json

###

PUT {{TemplateProject_HostAddress}}/api/unidades-medida/{{unidadMedidaId}}
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json; charset=utf-8

{
  "nombre": "Libra",
  "abreviatura": "Lb",
  "activo": true
}

